PROJECT_NAME="Upay ResolveAI Engine"
VERSION="1.0.0"
ENV="development"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database URL
# Default local SQLite for frictionless hackathon running, or PostgreSQL when available
DATABASE_URL="sqlite+aiosqlite:///./upay_resolveai.db"
POSTGRES_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/upay_resolveai"

# AI Engine configuration
DEMO_AI_MODE=true
AI_PROVIDER="demo_deterministic"
