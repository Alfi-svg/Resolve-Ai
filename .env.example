# ========================================================
# UPAY ResolveAI — Environment Configuration
# ========================================================

# Host & Port configuration
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173

# Environment mode ('development' | 'production' | 'hackathon_demo')
ENVIRONMENT=hackathon_demo

# Optional: Real LLM Gateway Integration (Gemini / OpenAI / Anthropic)
# If empty, ResolveAI operates in 100% deterministic grounded mode using synthetic transaction telemetry.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Vector Database for Enterprise Policy RAG (Phase 2 Roadmap)
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=
# PINECONE_INDEX_NAME=upay-policy-knowledgebase

# Upay Payment Gateway & Switch Mock Settings
GATEWAY_TIMEOUT_THRESHOLD_MS=10000
SYNTHETIC_DATASET_SIZE=42
ENABLE_AUDIT_LOGGING=true
